[native "org.zenframework.z8.server.base.table.value.VectorExpression"]
public class VectorExpression extends Expression {
	aggregation = Aggregation.None;

	public void setDefault(vector defaultValue);

	virtual public vector get();
	virtual public vector[] array();

	public VectorExpression operator = (vector value);
	public VectorExpression operator = (sql_vector value);

	public operator sql_vector();

	virtual protected sql_vector expression();

	public void setExpression(sql_vector expression);
}
