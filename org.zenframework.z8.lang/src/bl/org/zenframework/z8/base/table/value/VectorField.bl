[native "org.zenframework.z8.server.base.table.value.VectorField"]
public class VectorField extends Field {
	aggregation = Aggregation.None;

	public int length = 2;

	public vector defaultValue;

	virtual public vector getDefault();
	public void setDefault(vector defaultValue);

	public operator sql_vector();

	virtual public vector get();
	virtual public vector[] array();

	public VectorField operator = (vector value);
	public VectorField operator = (decimal[] value);
	public VectorField operator = (int[] value);
}
