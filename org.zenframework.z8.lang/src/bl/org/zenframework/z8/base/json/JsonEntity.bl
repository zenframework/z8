import org.zenframework.z8.lang.Object;

[native "org.zenframework.z8.server.base.json.JsonEntity"]
public class JsonEntity extends Object {

	public void operator = (JsonObject source);

	virtual public JsonObject toJson();
	virtual public JsonEntity fromJson(JsonObject json);

	virtual protected JsonEntity newObject(JsonObject json);

	public static JsonObject toJsonObject(Object object);
	public static JsonArray toJsonArray(Object[] array);

}
